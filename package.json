{
  "name": "@vx-daniel/pi-openai-proxy",
  "version": "4.9.6",
  "description": "OpenAI-compatible HTTP proxy for pi's multi-provider model registry",
  "keywords": [
    "gateway",
    "llm",
    "openai",
    "pi-coding-agent",
    "pi-package",
    "proxy"
  ],
  "license": "MIT",
  "author": "Victor Software House",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vx-daniel/pi-openai-proxy.git"
  },
  "bin": {
    "pi-openai-proxy": "dist/index.mjs"
  },
  "files": [
    "dist",
    "extensions"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "types": "./dist/config.d.mts"
    },
    "./exposure": {
      "import": "./dist/exposure.mjs",
      "types": "./dist/exposure.d.mts"
    },
    "./logging": {
      "import": "./dist/logging.mjs",
      "types": "./dist/logging.d.mts"
    },
    "./sync/zed": {
      "import": "./dist/sync-zed.mjs",
      "types": "./dist/sync-zed.d.mts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vp pack --watch --on-success \"node dist/index.mjs --port ${PI_PROXY_DEV_PORT:-4142}\"",
    "start": "node dist/index.mjs",
    "check:all": "node scripts/gate.ts",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "test:ci": "vp test --project offline",
    "test:live": "PI_PROXY_LIVE_TESTS=1 vp test --project live",
    "build": "vp pack",
    "prepare": "vp config --no-agent && vp pack",
    "prepack": "vp pack",
    "prepublishOnly": "vp test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@logtape/file": "^2.4.1",
    "@logtape/logtape": "^2.4.1",
    "@logtape/pretty": "^2.4.1",
    "@logtape/redaction": "^2.4.1",
    "citty": "^0.2.2",
    "hono": "^4.12.18",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@limegrass/eslint-plugin-import-alias": "^1.6.1",
    "@logtape/lint": "^2.4.1",
    "@logtape/testing": "^2.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^25.6.0",
    "eslint-plugin-zod": "^3.12.0",
    "openai": "^6.36.0",
    "semantic-release": "^25.0.3",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
